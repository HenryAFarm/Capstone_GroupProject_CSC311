<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<StackPane stylesheets="@style.css" styleClass="app-root"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.capstone_groupproject_csc311.service.UIController"
           prefHeight="600.0" prefWidth="800.0">
    <VBox fx:id="mainContent" alignment="TOP_CENTER" spacing="10.0"
          maxWidth="760.0" styleClass="content-card">
        <padding>
            <Insets bottom="16.0" left="28.0" right="28.0" top="16.0"/>
        </padding>

        <StackPane prefHeight="58.0" maxWidth="700.0">
            <VBox alignment="CENTER" spacing="5.0" styleClass="heading">
                <Label text="Image Describer" styleClass="title"/>
                <Label text="Choose an image or drag one into the preview area." styleClass="subtitle"/>
            </VBox>
        </StackPane>

        <StackPane fx:id="imageDropArea" alignment="CENTER" prefHeight="325.0"
                   maxWidth="700.0" styleClass="drop-area">
            <ImageView fx:id="imagePreview" fitWidth="660.0" fitHeight="285.0"
                       preserveRatio="true" smooth="true"/>
            <Label fx:id="placeholderLabel" text="Drop an image here" styleClass="placeholder"/>
        </StackPane>

        <Button text="Choose Image..." onAction="#chooseImage" styleClass="primary-button"/>
        <Label fx:id="statusLabel" text="No image selected." wrapText="true" styleClass="status-label"/>
        <Label text="Generated description" styleClass="section-title"/>
        <HBox alignment="CENTER" spacing="12.0" maxWidth="660.0" styleClass="caption-row">
            <TextArea fx:id="captionPreview" text="The generated description will appear here."
                      prefWidth="460.0" prefRowCount="3" maxWidth="480.0"
                      wrapText="true" editable="false" styleClass="caption-area"/>
            <Button fx:id="speakButton" text="Read Aloud" onAction="#speakDescription"
                    disable="true" styleClass="secondary-button"/>
        </HBox>
    </VBox>

    <VBox fx:id="accountBrowser" spacing="10.0" visible="false" managed="false"
          styleClass="account-browser">
        <padding>
            <Insets bottom="18.0" left="18.0" right="18.0" top="18.0"/>
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Button text="Back to app" onAction="#returnToMainView"
                    styleClass="secondary-button"/>
            <Label text="Account" styleClass="section-title"/>
        </HBox>
        <WebView fx:id="accountWebView" VBox.vgrow="ALWAYS"/>
    </VBox>

    <VBox fx:id="accountMenu" alignment="TOP_RIGHT" spacing="2.0"
          maxWidth="150.0" maxHeight="70.0" pickOnBounds="false"
          StackPane.alignment="TOP_RIGHT" styleClass="account-menu">
        <padding>
            <Insets right="12.0" top="10.0"/>
        </padding>
        <Button text="?" onAction="#showLoginPage" styleClass="account-icon-button"/>
        <Hyperlink text="Create profile" onAction="#showRegistrationPage"
                   styleClass="account-link"/>
    </VBox>
</StackPane>
